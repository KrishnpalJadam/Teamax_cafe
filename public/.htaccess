# Apache configuration for Next.js Static Export
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # =========================================================
  # 1. 301 Permanent Redirects for Removed & Migrated Routes
  # =========================================================
  # Permanently redirect /careers/ to homepage /
  RewriteRule ^careers/?$ / [R=301,L]

  # Redirect legacy /ourcentres/ to /locations/
  RewriteRule ^ourcentres/stores/?$ /locations/stores/ [R=301,L,QSA]
  RewriteRule ^ourcentres/?$ /locations/ [R=301,L]
  RewriteRule ^ourcentres/(.*)$ /locations/$1 [R=301,L]

  # Redirect legacy /franchise-opportunities/ to /franchise/
  RewriteRule ^franchise-opportunities/?$ /franchise/ [R=301,L]
  RewriteRule ^franchise-opportunities/(.*)$ /franchise/$1 [R=301,L]

  # Redirect legacy /blog/ to /post/
  RewriteRule ^blog/?$ /post/ [R=301,L]
  RewriteRule ^blog/(.*)$ /post/$1 [R=301,L]

  # Redirect duplicate Express and stores routes
  RewriteRule ^Express/?$ /best-tea-franchise-india/ [R=301,L]
  RewriteRule ^stores/?$ /locations/ [R=301,L]

  # =========================================================
  # 2. Static File & Directory Fallbacks
  # =========================================================
  # If physical file exists, serve directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # If folder with index.html exists, serve folder/index.html
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)/?$ $1/index.html [L]

  # If file with .html extension exists, serve it
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 404 fallback
  ErrorDocument 404 /404.html
</IfModule>

# Prevent directory indexing
Options -Indexes

# Set proper MIME types for modern web assets
<IfModule mod_mime.c>
  AddType text/html .html
  AddType text/css .css
  AddType application/javascript .js
  AddType application/json .json .webmanifest
  AddType image/webp .webp
  AddType image/avif .avif
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>
