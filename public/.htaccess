# Apache configuration for Next.js Static Export
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. If physical file exists, serve directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. If folder with index.html exists, serve folder/index.html
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)/?$ $1/index.html [L]

  # 3. If file with .html extension exists, serve it
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 4. Handle 404 fallback
  ErrorDocument 404 /404.html
</IfModule>

# Prevent directory indexing
Options -Indexes

# Set proper MIME types for modern web assets
<IfModule mod_mime.c>
  AddType text/html .html
  AddType text/css .css
  AddType application/javascript .js
  AddType application/json .json .webmanifest
  AddType image/webp .webp
  AddType image/avif .avif
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

